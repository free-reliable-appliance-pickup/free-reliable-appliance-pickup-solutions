<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Appliance Pickup Partner Program | Free Reliable Appliance Pickup</title>

<meta
name="description"
content="Join the Free Reliable Appliance Pickup partner network. Choose service areas across all 50 states, search cities A-Z, select up to 50 cities, and apply for appliance pickup territory opportunities."
>

<meta name="robots" content="index, follow">

<link
rel="canonical"
href="https://free-reliable-appliance-pickup.github.io/free-reliable-appliance-pickup-solutions/partners/"
>

<style>

:root{
--green:#0b5d35;
--green2:#087443;
--dark:#17352a;
--light:#eef8f2;
--border:#d8e5dd;
--text:#222;
--muted:#666;
--white:#fff;
--danger:#a12622;
--gold:#f4b400;
}

*{
box-sizing:border-box;
}

html{
scroll-behavior:smooth;
}

body{
margin:0;
font-family:Arial,Helvetica,sans-serif;
line-height:1.6;
color:var(--text);
background:#f5f5f5;
}

a{
color:inherit;
}

header{
background:linear-gradient(135deg,var(--green),var(--green2));
color:#fff;
text-align:center;
padding:58px 20px;
}

header h1{
margin:0 0 14px;
font-size:2.45rem;
line-height:1.15;
}

header p{
max-width:900px;
margin:0 auto 24px;
font-size:1.08rem;
}

.hero-button{
display:inline-block;
text-decoration:none;
background:#fff;
color:var(--green);
padding:14px 22px;
border-radius:8px;
font-weight:700;
}

nav{
position:sticky;
top:0;
z-index:20;
background:var(--dark);
text-align:center;
padding:11px 8px;
}

nav a{
color:#fff;
text-decoration:none;
font-weight:700;
display:inline-block;
margin:5px 10px;
}

main{
max-width:1120px;
margin:auto;
padding:28px 16px 50px;
}

section{
background:#fff;
margin-bottom:24px;
padding:30px;
border-radius:12px;
box-shadow:0 3px 12px rgba(0,0,0,.08);
}

h2,
h3{
color:var(--green);
}

h2{
margin-top:0;
line-height:1.25;
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:18px;
margin-top:20px;
}

.card{
background:#f7faf8;
border:1px solid var(--border);
padding:20px;
border-radius:9px;
}

.card h3{
margin-top:0;
}

.notice{
background:var(--light);
border-left:5px solid var(--green);
padding:16px;
margin:18px 0;
border-radius:6px;
}

.warning{
background:#fff8e8;
border-left:5px solid var(--gold);
padding:16px;
margin:18px 0;
border-radius:6px;
}

.steps{
counter-reset:step;
list-style:none;
padding:0;
margin:0;
}

.steps li{
counter-increment:step;
margin:0 0 17px;
padding-left:44px;
position:relative;
}

.steps li:before{
content:counter(step);
position:absolute;
left:0;
top:0;
width:30px;
height:30px;
line-height:30px;
text-align:center;
border-radius:50%;
color:#fff;
background:var(--green);
font-weight:700;
}

.territory-box{
background:#f8fbf9;
border:1px solid var(--border);
padding:22px;
border-radius:12px;
}

.row{
display:grid;
grid-template-columns:1fr 1fr;
gap:16px;
}

label{
display:block;
font-weight:700;
margin-bottom:6px;
}

input,
select,
textarea,
button{
font:inherit;
}

input,
select,
textarea{
width:100%;
border:1px solid #b8c6bd;
border-radius:8px;
padding:12px 13px;
background:#fff;
}

textarea{
resize:vertical;
min-height:110px;
}

.helper{
font-size:.92rem;
color:var(--muted);
margin-top:5px;
}

.status{
font-size:.94rem;
margin-top:10px;
font-weight:700;
color:var(--green);
}

.az-title{
font-weight:700;
margin:22px 0 9px;
}

.az{
display:flex;
flex-wrap:wrap;
gap:7px;
}

.az button{
width:auto;
min-width:39px;
border:1px solid var(--green);
border-radius:7px;
background:#fff;
color:var(--green);
padding:9px 10px;
font-weight:700;
cursor:pointer;
}

.az button:hover,
.az button.active{
background:var(--green);
color:#fff;
}

.az button:disabled{
opacity:.28;
cursor:not-allowed;
}

.city-toolbar{
display:flex;
justify-content:space-between;
gap:12px;
align-items:center;
flex-wrap:wrap;
margin:18px 0 10px;
}

.city-meta{
color:var(--muted);
font-weight:700;
}

.clear-filter{
border:1px solid #aaa;
background:#fff;
padding:8px 12px;
border-radius:7px;
cursor:pointer;
}

.city-list{
display:grid;
grid-template-columns:repeat(auto-fill,minmax(190px,1fr));
gap:9px;
max-height:500px;
overflow:auto;
padding-right:4px;
}

.city-item{
width:100%;
text-align:left;
background:#fff;
border:1px solid var(--border);
border-radius:8px;
padding:11px 12px;
cursor:pointer;
}

.city-item:hover{
background:var(--light);
border-color:var(--green);
}

.city-item strong{
display:block;
color:var(--green);
}

.city-item small{
color:var(--muted);
}

.empty{
grid-column:1/-1;
background:#fff8e8;
border:1px solid #ead8a4;
border-radius:8px;
padding:16px;
}

.manual-add{
margin-top:18px;
border-top:1px solid var(--border);
padding-top:18px;
}

.manual-row{
display:grid;
grid-template-columns:1fr auto;
gap:9px;
}

.add-button{
border:0;
border-radius:8px;
background:var(--green);
color:#fff;
padding:0 18px;
font-weight:700;
cursor:pointer;
}

.selected-wrap{
margin-top:22px;
background:#fff;
border:1px solid var(--border);
border-radius:10px;
padding:16px;
}

.selected-head{
display:flex;
justify-content:space-between;
align-items:center;
gap:10px;
flex-wrap:wrap;
}

.selected-head strong{
color:var(--green);
}

.selected-count{
font-weight:700;
}

.selected-list{
display:flex;
flex-wrap:wrap;
gap:8px;
margin-top:12px;
}

.selected-chip{
display:inline-flex;
align-items:center;
gap:8px;
background:var(--light);
border:1px solid #b9dac7;
border-radius:999px;
padding:7px 10px 7px 12px;
}

.selected-chip button{
width:24px;
height:24px;
line-height:20px;
border:0;
border-radius:50%;
background:#fff;
color:var(--danger);
cursor:pointer;
font-weight:700;
}

.small-button{
border:1px solid #bbb;
background:#fff;
padding:7px 10px;
border-radius:7px;
cursor:pointer;
}

.apply-grid{
display:grid;
grid-template-columns:1fr 1fr;
gap:14px;
}

.full{
grid-column:1/-1;
}

.checkbox-row{
display:flex;
gap:9px;
align-items:flex-start;
}

.checkbox-row input{
width:auto;
margin-top:5px;
}

.submit{
width:100%;
border:0;
border-radius:8px;
padding:15px 20px;
background:var(--green);
color:#fff;
font-weight:700;
cursor:pointer;
font-size:1.05rem;
}

footer{
background:#1e1e1e;
color:#fff;
text-align:center;
padding:30px 18px;
}

footer a{
color:#fff;
}

@media(max-width:720px){

header{
padding:44px 17px;
}

header h1{
font-size:1.9rem;
}

section{
padding:22px 17px;
}

.row,
.apply-grid{
grid-template-columns:1fr;
}

.full{
grid-column:auto;
}

.manual-row{
grid-template-columns:1fr;
}

.add-button{
padding:12px;
}

.city-list{
grid-template-columns:1fr 1fr;
}

}

@media(max-width:450px){

.city-list{
grid-template-columns:1fr;
}

}

</style>
</head>

<body>

<header>

<h1>
Appliance Pickup Partner Program
</h1>

<p>
Build your appliance pickup territory with Free Reliable Appliance Pickup.
Choose any U.S. state, search cities, browse cities A–Z,
select up to 50 cities and apply for available territory opportunities.
</p>

<a
class="hero-button"
href="#territories">
Choose Your Territory
</a>

</header>

<nav>

