    document.getElementById("formSuccess");

const copyApplication =
    document.getElementById("copyApplication");

document.getElementById("year").textContent =
    new Date().getFullYear();


function normalizeCityRecord(record) {

    return {
        state: String(record.state || "")
            .trim()
            .toUpperCase(),

        city: String(record.city || "")
            .trim(),

        zip_codes: Array.isArray(record.zip_codes)
            ? record.zip_codes.map(String)
            : []
    };
}


function cityKey(record) {

    return (
        record.state +
        "|" +
        record.city.toLowerCase()
    );
}


function mergeCityLists(primary, fallback) {

    const map = new Map();

    [...primary, ...fallback].forEach(item => {

        const clean =
            normalizeCityRecord(item);

        if (!clean.state || !clean.city) {
            return;
        }

        const key =
            cityKey(clean);

        if (!map.has(key)) {
            map.set(key, clean);
        }
        else {

            const existing =
                map.get(key);

            const mergedZips =
                new Set([
                    ...existing.zip_codes,
                    ...clean.zip_codes
                ]);

            existing.zip_codes =
                [...mergedZips];
        }
    });

    return [...map.values()]
        .sort((a,b) => {

            if (a.state !== b.state) {
                return a.state.localeCompare(b.state);
            }

            return a.city.localeCompare(b.city);
        });
}


function loadSavedSelections() {

    try {

        const saved =
            JSON.parse(
                localStorage.getItem(
                    "partnerSelectedCoverage"
                ) || "[]"
            );

        if (Array.isArray(saved)) {

            saved.forEach(item => {

                const clean =
                    normalizeCityRecord(item);

                if (clean.state && clean.city) {
                    selected.set(
                        cityKey(clean),
                        clean
                    );
                }
            });
        }
    }
    catch (error) {
        console.warn(
            "Could not load saved coverage.",
            error
        );
    }
}


function saveSelections() {

    localStorage.setItem(
        "partnerSelectedCoverage",
        JSON.stringify(
            [...selected.values()]
        )
    );
}


function createLetters() {

    letters.innerHTML = "";

    "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        .split("")
        .forEach(letter => {

            const button =
                document.createElement("button");

            button.type = "button";
            button.textContent = letter;
            button.className =
                "letter-btn" +
                (
                    letter === activeLetter
                    ? " active"
                    : ""
                );

            button.addEventListener(
                "click",
                function () {

                    activeLetter =
                        letter;

                    citySearch.value =
                        "";

                    createLetters();
                    renderCities();
                }
            );

            letters.appendChild(button);
        });
}


function getStateCities(state) {

    return cities.filter(
        item =>
            item.state === state
    );
}


function getFilteredCities() {

    const state =
        stateSelect.value;

    if (!state) {
        return [];
    }

    const query =
        citySearch.value
            .trim()
            .toLowerCase();

    const stateCities =
        getStateCities(state);

    if (query) {

        return stateCities.filter(item => {

            const cityMatch =
                item.city
                    .toLowerCase()
                    .includes(query);

            const zipMatch =
                item.zip_codes.some(
                    zip =>
                        String(zip)
                            .includes(query)
                );

            return cityMatch || zipMatch;
        });
    }

    return stateCities.filter(
        item =>
            item.city
                .charAt(0)
                .toUpperCase() ===
            activeLetter
    );
}


function renderCities() {

    const state =
        stateSelect.value;

    if (!state) {

        visibleCities = [];

        stateStatus.textContent =
            "Select a state to browse cities.";

        resultsTitle.textContent =
            "Choose a state and letter.";

        cityBox.innerHTML =
            '<div class="empty">' +
            'Select a state above to see available cities.' +
            '</div>';

        return;
    }

    const stateName =
        STATE_NAMES[state] || state;

    const totalInState =
        getStateCities(state).length;

    stateStatus.textContent =
        totalInState +
        " database " +
        (
            totalInState === 1
            ? "city"
            : "cities"
        ) +
        " currently available in " +
        stateName +
        ".";

    visibleCities =
        getFilteredCities();

    const query =
        citySearch.value.trim();

    if (query) {

        resultsTitle.textContent =
            'Search results for "' +
            query +
            '" in ' +
            stateName +
            " — " +
            visibleCities.length +
            " found";
    }
    else {

        resultsTitle.textContent =
            activeLetter +
            " Cities in " +
            stateName +
            " — " +
            visibleCities.length +
            " available";
    }

    cityBox.innerHTML = "";

    if (!visibleCities.length) {

        cityBox.innerHTML =
            '<div class="empty">' +
            'No matching database cities yet. ' +
            'Use "Can\'t Find Your City?" below to add it.' +
            '</div>';

        return;
    }

    visibleCities.forEach(item => {

        const key =
            cityKey(item);

        const label =
            document.createElement("label");

        label.className =
            "city-row";

        const checkbox =
            document.createElement("input");

        checkbox.type =
            "checkbox";

        checkbox.checked =
            selected.has(key);

        checkbox.addEventListener(
            "change",
            function () {

                if (checkbox.checked) {

                    selected.set(
                        key,
                        item
                    );
                }
                else {

                    selected.delete(key);
                }

                saveSelections();
                renderSelected();
            }
        );

        const text =
            document.createElement("div");

        const name =
            document.createElement("div");

        name.className =
            "city-name";

        name.textContent =
            item.city +
            ", " +
            item.state;

        text.appendChild(name);

        if (item.zip_codes.length) {

            const zips =
                document.createElement("div");

            zips.className =
                "city-zips";

            zips.textContent =
                "ZIP: " +
                item.zip_codes.join(", ");

            text.appendChild(zips);
        }

        label.appendChild(checkbox);
        label.appendChild(text);

        cityBox.appendChild(label);
    });
}


function renderSelected() {

    const values =
        [...selected.values()]
        .sort((a,b) => {

            if (a.state !== b.state) {
                return a.state.localeCompare(b.state);
            }

            return a.city.localeCompare(b.city);
        });

    selectedCount.textContent =
        values.length +
        (
            values.length === 1
            ? " city selected"
            : " cities selected"
        );

    selectedChips.innerHTML =
        "";

    values.forEach(item => {

        const chip =
            document.createElement("div");

        chip.className =
            "chip";

        const text =
            document.createElement("span");

        text.textContent =
            item.city +
            ", " +
            item.state;

        const remove =
            document.createElement("button");

        remove.type =
            "button";

        remove.setAttribute(
            "aria-label",
            "Remove " +
            item.city +
            ", " +
            item.state
        );

        remove.textContent =
            "×";

        remove.addEventListener(
            "click",
            function () {

                selected.delete(
                    cityKey(item)
                );

                saveSelections();
                renderSelected();
                renderCities();
            }
        );

        chip.appendChild(text);
        chip.appendChild(remove);

        selectedChips.appendChild(chip);
    });
}


stateSelect.addEventListener(
    "change",
    function () {

        citySearch.value =
            "";

        activeLetter =
            "A";

        createLetters();
        renderCities();
    }
);


citySearch.addEventListener(
    "input",
    function () {

        renderCities();
    }
);


selectVisible.addEventListener(
    "click",
    function () {

        visibleCities.forEach(item => {

            selected.set(
                cityKey(item),
                item
            );
        });

        saveSelections();
        renderSelected();
        renderCities();
    }
);


clearState.addEventListener(
    "click",
    function () {

        const state =
            stateSelect.value;

        if (!state) {
            return;
        }

        [...selected.entries()]
            .forEach(([key,item]) => {

                if (item.state === state) {
                    selected.delete(key);
                }
            });

        saveSelections();
        renderSelected();
        renderCities();
    }
);


addManual.addEventListener(
    "click",
    function () {

        formError.style.display =
            "none";

        const state =
            stateSelect.value;

        const city =
            manualCity.value.trim();

        const zip =
            manualZip.value.trim();

        if (!state) {

            showError(
                "Select a state before adding a city."
            );

            return;
        }

        if (!city) {

            showError(
                "Enter the city you want to add."
            );

            manualCity.focus();

            return;
        }

        if (
            zip &&
            !/^\d{5}$/.test(zip)
        ) {

            showError(
                "ZIP code must contain 5 numbers."
            );

            manualZip.focus();

            return;
        }

        const item = {
            state: state,
            city: city,
            zip_codes:
                zip ? [zip] : []
        };

        selected.set(
            cityKey(item),
            item
        );

        saveSelections();
        renderSelected();

        manualCity.value =
            "";

        manualZip.value =
            "";
    }
);


function showError(message) {

    formSuccess.style.display =
        "none";

    formError.textContent =
        message;

    formError.style.display =
        "block";

    formError.scrollIntoView({
        behavior: "smooth",
        block: "center"
    });
}


function buildApplicationText() {

    const fullName =
        document.getElementById(
            "fullName"
        ).value.trim();

    const businessName =
        document.getElementById(
            "businessName"
        ).value.trim();

    const email =
        document.getElementById(
            "email"
        ).value.trim();

    const phone =
        document.getElementById(
            "phone"
        ).value.trim();

    const coverage =
        [...selected.values()]
        .sort((a,b) => {

            if (a.state !== b.state) {
                return a.state.localeCompare(b.state);
            }

            return a.city.localeCompare(b.city);
        });

    const lines = [
        "FREE RELIABLE APPLIANCE PICKUP",
        "PARTNER NETWORK APPLICATION",
        "",
        "Full Name: " + fullName,
        "Business Name: " +
            (businessName || "Not provided"),
        "Email: " + email,
        "Phone: " + phone,
        "",
        "SELECTED SERVICE AREAS:"
    ];

    coverage.forEach(
        (item,index) => {

            let line =
                (index + 1) +
                ". " +
                item.city +
                ", " +
                item.state;

            if (item.zip_codes.length) {

                line +=
                    " | ZIP: " +
                    item.zip_codes.join(", ");
            }

            lines.push(line);
        }
    );

    lines.push("");
    lines.push(
        "Submitted: " +
        new Date().toLocaleString()
    );

    return lines.join("\n");
}


partnerForm.addEventListener(
    "submit",
    function (event) {

        event.preventDefault();

        formError.style.display =
            "none";

        formSuccess.style.display =
            "none";

        const fullName =
            document.getElementById(
                "fullName"
            );

        const email =
            document.getElementById(
                "email"
            );

        const phone =
            document.getElementById(
                "phone"
            );

        if (!fullName.value.trim()) {

            showError(
                "Please enter your full name."
            );

            fullName.focus();
            return;
        }

        if (!email.value.trim()) {

            showError(
                "Please enter your email address."
            );

            email.focus();
            return;
        }

        if (
            !email.checkValidity()
        ) {

            showError(
                "Please enter a valid email address."
            );

            email.focus();
            return;
        }

        if (!phone.value.trim()) {

            showError(
                "Please enter your phone number."
            );

            phone.focus();
            return;
        }

        if (selected.size === 0) {

            showError(
                "Please select at least one service city."
            );

            return;
        }

        lastApplicationText =
            buildApplicationText();

        const applicationData = {
            fullName:
                fullName.value.trim(),

            businessName:
                document.getElementById(
                    "businessName"
                ).value.trim(),

            email:
                email.value.trim(),

            phone:
                phone.value.trim(),

            coverage:
                [...selected.values()],

            submittedAt:
                new Date().toISOString()
        };

        try {

            localStorage.setItem(
                "pendingPartnerSignup",
                JSON.stringify(
                    applicationData
                )
            );

            localStorage.setItem(
                "partnerSelectedCoverage",
                JSON.stringify(
                    [...selected.values()]
                )
            );
        }
        catch (error) {

            console.warn(
                "Could not save application locally.",
                error
            );
        }

        submitButton.disabled =
            true;

        submitButton.textContent =
            "Application Saved ✓";

        formSuccess.style.display =
            "block";

        formSuccess.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });

        const subject =
            "New Partner Application - " +
            fullName.value.trim();

        const mailto =
            "mailto:" +
            BUSINESS_EMAIL +
            "?subject=" +
            encodeURIComponent(subject) +
            "&body=" +
            encodeURIComponent(
                lastApplicationText
            );

        setTimeout(
            function () {

                window.location.href =
                    mailto;

            },
            500
        );
    }
);


copyApplication.addEventListener(
    "click",
    async function () {

        if (!lastApplicationText) {

            lastApplicationText =
                buildApplicationText();
        }

        try {

            await navigator.clipboard
                .writeText(
                    lastApplicationText
                );

            copyApplication.textContent =
                "Application Copied ✓";

        }
        catch (error) {

            const textarea =
                document.createElement(
                    "textarea"
                );

            textarea.value =
                lastApplicationText;

            document.body
                .appendChild(textarea);

            textarea.select();

            document.execCommand(
                "copy"
            );

            textarea.remove();

            copyApplication.textContent =
                "Application Copied ✓";
        }
    }
);


async function loadCities() {

    try {

        const response =
            await fetch(
                "../data/cities.json?v=" +
                Date.now(),
                {
                    cache: "no-store"
                }
            );

        if (!response.ok) {

            throw new Error(
                "cities.json could not be loaded"
            );
        }

        const data =
            await response.json();

        if (!Array.isArray(data)) {

            throw new Error(
                "cities.json is not an array"
            );
        }

        cities =
            mergeCityLists(
                data,
                FALLBACK_CITIES
            );
    }
    catch (error) {

        console.error(
            "City database error:",
            error
        );

        cities =
            mergeCityLists(
                [],
                FALLBACK_CITIES
            );
    }

    createLetters();
    renderCities();
}


loadSavedSelections();
renderSelected();
createLetters();
loadCities();

})();
</script>

</body>
</html>
