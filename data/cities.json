{stateSlug:"colorado",state:"Colorado",city:"Broomfield"},
{stateSlug:"colorado",state:"Colorado",city:"Centennial"},
{stateSlug:"colorado",state:"Colorado",city:"Commerce City"},
{stateSlug:"colorado",state:"Colorado",city:"Denver"},
{stateSlug:"colorado",state:"Colorado",city:"Englewood"},
{stateSlug:"colorado",state:"Colorado",city:"Golden"},
{stateSlug:"colorado",state:"Colorado",city:"Lakewood"},
{stateSlug:"colorado",state:"Colorado",city:"Littleton"},
{stateSlug:"colorado",state:"Colorado",city:"Parker"},
{stateSlug:"colorado",state:"Colorado",city:"Thornton"},
{stateSlug:"colorado",state:"Colorado",city:"Westminster"},
{stateSlug:"colorado",state:"Colorado",city:"Wheat Ridge"},

{stateSlug:"oregon",state:"Oregon",city:"Beaverton"},
{stateSlug:"oregon",state:"Oregon",city:"Gresham"},
{stateSlug:"oregon",state:"Oregon",city:"Hillsboro"},
{stateSlug:"oregon",state:"Oregon",city:"Keizer"},
{stateSlug:"oregon",state:"Oregon",city:"Portland"},
{stateSlug:"oregon",state:"Oregon",city:"Salem"},
{stateSlug:"oregon",state:"Oregon",city:"Tigard"},

{stateSlug:"washington",state:"Washington",city:"Bellevue"},
{stateSlug:"washington",state:"Washington",city:"Everett"},
{stateSlug:"washington",state:"Washington",city:"Kent"},
{stateSlug:"washington",state:"Washington",city:"Seattle"},
{stateSlug:"washington",state:"Washington",city:"Tacoma"},
{stateSlug:"washington",state:"Washington",city:"Vancouver"},

{stateSlug:"utah",state:"Utah",city:"Ogden"},
{stateSlug:"utah",state:"Utah",city:"Park City"},
{stateSlug:"utah",state:"Utah",city:"Provo"},
{stateSlug:"utah",state:"Utah",city:"Salt Lake City"},
{stateSlug:"utah",state:"Utah",city:"Sandy"},

{stateSlug:"nevada",state:"Nevada",city:"Henderson"},
{stateSlug:"nevada",state:"Nevada",city:"Las Vegas"},
{stateSlug:"nevada",state:"Nevada",city:"North Las Vegas"},
{stateSlug:"nevada",state:"Nevada",city:"Reno"},
{stateSlug:"nevada",state:"Nevada",city:"Sparks"},

{stateSlug:"idaho",state:"Idaho",city:"Boise"},
{stateSlug:"idaho",state:"Idaho",city:"Caldwell"},
{stateSlug:"idaho",state:"Idaho",city:"Meridian"},
{stateSlug:"idaho",state:"Idaho",city:"Nampa"}

];


let allCities = [];

let selectedCities = [];

let activeLetter = "";


function slugToTitle(slug){

return slug
.split("-")
.filter(Boolean)
.map(function(word){

return word.charAt(0).toUpperCase() + word.slice(1);

})
.join(" ");

}


function normalizeText(value){

return (value || "")
.trim()
.replace(/\s+/g," ");

}


function uniqueCities(cities){

const seen = new Set();

return cities
.filter(function(city){

const key =
(city.stateSlug + "|" + city.city).toLowerCase();

if(seen.has(key)){
return false;
}

seen.add(key);

return true;

})
.sort(function(a,b){

const cityCompare =
a.city.localeCompare(b.city);

if(cityCompare !== 0){
return cityCompare;
}

return a.state.localeCompare(b.state);

});

}


async function loadCities(){

let sitemapCities = [];

try{

const response =
await fetch("../sitemap.xml",{
cache:"no-store"
});

if(response.ok){

const text =
await response.text();

const xml =
new DOMParser()
.parseFromString(
text,
"application/xml"
);

const locations =
Array.from(
xml.querySelectorAll("loc")
)
.map(function(node){

return node.textContent.trim();

});


locations.forEach(function(rawUrl){

try{

const url =
new URL(rawUrl);

const parts =
url.pathname
.split("/")
.filter(Boolean);

const repoPosition =
parts.indexOf(
"free-reliable-appliance-pickup-solutions"
);

if(repoPosition === -1){
return;
}

const stateSlug =
parts[repoPosition + 1];

const citySlug =
parts[repoPosition + 2];

if(!stateSlug || !citySlug){
return;
}

if(!STATE_NAMES[stateSlug]){
return;
}

if(citySlug === "partners"){
return;
}

sitemapCities.push({

stateSlug:stateSlug,

state:
STATE_NAMES[stateSlug],

city:
slugToTitle(citySlug),

citySlug:citySlug,

url:rawUrl

});

}catch(error){}

});

}

}catch(error){}


allCities =
uniqueCities(
sitemapCities.concat(FALLBACK_CITIES)
);

renderAZ();

renderCities();

}


function getChosenState(){

return document
.getElementById("stateSelect")
.value;

}


function getChosenStateName(){

const slug =
getChosenState();

return slug
? STATE_NAMES[slug]
: "";

}


function getStateCities(){

const state =
getChosenState();

if(!state){
return [];
}

return allCities.filter(function(city){

return city.stateSlug === state;

});

}


function getAvailableLetters(){

const letters =
new Set();

getStateCities()
.forEach(function(city){

if(city.city){

letters.add(
city.city
.charAt(0)
.toUpperCase()
);

}

});

return letters;

}


function renderAZ(){

const wrap =
document.getElementById(
"azButtons"
);

const availableLetters =
getAvailableLetters();

wrap.innerHTML = "";

"ABCDEFGHIJKLMNOPQRSTUVWXYZ"
.split("")
.forEach(function(letter){

const button =
document.createElement(
"button"
);

button.type =
"button";

button.textContent =
letter;

const stateSelected =
Boolean(
getChosenState()
);

const available =
availableLetters.has(letter);

button.disabled =
!stateSelected ||
!available;

if(activeLetter === letter){

button.classList.add(
"active"
);

}

button.addEventListener(
"click",
function(){

if(activeLetter === letter){

activeLetter = "";

}else{

activeLetter = letter;

}

document
.getElementById(
"citySearch"
)
.value = "";

renderAZ();

renderCities();

}
);

wrap.appendChild(
button
);

});

}


function filteredCities(){

const state =
getChosenState();

const query =
normalizeText(
document
.getElementById(
"citySearch"
)
.value
)
.toLowerCase();

if(!state){
return [];
}

return allCities.filter(
function(city){

if(city.stateSlug !== state){

return false;

}

if(
activeLetter &&
city.city
.charAt(0)
.toUpperCase()
!== activeLetter
){

return false;

}

if(
query &&
!city.city
.toLowerCase()
.includes(query)
){

return false;

}

return true;

}
);

}


function renderCities(){

const list =
document.getElementById(
"cityList"
);

const meta =
document.getElementById(
"cityMeta"
);

const state =
getChosenState();

const query =
normalizeText(
document
.getElementById(
"citySearch"
)
.value
);

const cities =
filteredCities();

list.innerHTML = "";


if(!state){

meta.textContent =
"Choose a state to view cities.";

const empty =
document.createElement(
"div"
);

empty.className =
"empty";

empty.textContent =
"Choose a state above to begin.";

list.appendChild(
empty
);

return;

}


let description =
cities.length +
" city" +
(cities.length === 1 ? "" : "ies") +
" shown in " +
STATE_NAMES[state];


if(activeLetter){

description +=
" starting with " +
activeLetter;

}


if(query){

description +=
' matching "' +
query +
'"';

}


meta.textContent =
description + ".";


if(cities.length === 0){

const empty =
document.createElement(
"div"
);

empty.className =
"empty";

empty.innerHTML =
"<strong>No matching city was found.</strong><br>You can still type the city in the manual city box and add it to your territory.";

list.appendChild(
empty
);

return;

}


cities.forEach(
function(city){

const button =
document.createElement(
"button"
);

button.type =
"button";

button.className =
"city-item";

button.innerHTML =
"<strong>" +
city.city +
"</strong>" +
city.state;

button.addEventListener(
"click",
function(){

addSelectedCity(
city.city,
city.stateSlug
);

}
);

list.appendChild(
button
);

}
);

}


function addSelectedCity(
cityName,
stateSlug
){

const city =
normalizeText(
cityName
);

if(
!city ||
!stateSlug
){

return;

}


const stateName =
STATE_NAMES[stateSlug];


const duplicate =
selectedCities.some(
function(item){

return (
item.city.toLowerCase()
===
city.toLowerCase()
&&
item.stateSlug
===
stateSlug
);

}
);


if(duplicate){

alert(
city +
", " +
stateName +
" is already selected."
);

return;

}


if(
selectedCities.length >= 50
){

alert(
"You can select up to 50 cities in the standard territory request."
);

return;

}


selectedCities.push({

city:city,

stateSlug:stateSlug,

state:stateName

});


updateSelectedCities();

}


function removeSelectedCity(
index
){

selectedCities.splice(
index,
1
);

updateSelectedCities();

}


function updateSelectedCities(){

const list =
document.getElementById(
"selectedList"
);

const count =
document.getElementById(
"selectedCount"
);

const territory =
document.getElementById(
"territoryField"
);


count.textContent =
selectedCities.length +
" / 50 cities";


list.innerHTML = "";


if(
selectedCities.length === 0
){

const helper =
document.createElement(
"span"
);

helper.className =
"helper";

helper.textContent =
"No cities selected yet.";

list.appendChild(
helper
);

}else{


selectedCities.forEach(
function(item,index){

const chip =
document.createElement(
"span"
);

chip.className =
"selected-chip";


const text =
document.createElement(
"span"
);

text.textContent =
item.city +
", " +
item.state;


const remove =
document.createElement(
"button"
);

remove.type =
"button";

remove.setAttribute(
"aria-label",
"Remove " +
item.city
);

remove.textContent =
"×";


remove.addEventListener(
"click",
function(){

removeSelectedCity(
index
);

}
);


chip.appendChild(
text
);

chip.appendChild(
remove
);

list.appendChild(
chip
);

}
);

}


territory.value =
selectedCities
.map(function(item){

return (
item.city +
", " +
item.state
);

})
.join("; ");

}


document
.getElementById(
"stateSelect"
)
.addEventListener(
"change",
function(){

activeLetter = "";

document
.getElementById(
"citySearch"
)
.value = "";


const stateName =
getChosenStateName();


if(stateName){

document
.getElementById(
"primaryState"
)
.value =
stateName;

}


renderAZ();

renderCities();

}
);


document
.getElementById(
"citySearch"
)
.addEventListener(
"input",
function(){

activeLetter = "";

renderAZ();

renderCities();

}
);


document
.getElementById(
"clearFilter"
)
.addEventListener(
"click",
function(){

activeLetter = "";

document
.getElementById(
"citySearch"
)
.value = "";

renderAZ();

renderCities();

}
);


document
.getElementById(
"manualAddButton"
)
.addEventListener(
"click",
function(){

const state =
getChosenState();

const input =
document.getElementById(
"manualCity"
);

const city =
normalizeText(
input.value
);


if(!state){

alert(
"Choose a state first."
);

return;

}


if(!city){

alert(
"Type a city name first."
);

return;

}


addSelectedCity(
city,
state
);

input.value = "";

}
);


document
.getElementById(
"manualCity"
)
.addEventListener(
"keydown",
function(event){

if(
event.key === "Enter"
){

event.preventDefault();

document
.getElementById(
"manualAddButton"
)
.click();

}

}
);


document
.getElementById(
"clearSelected"
)
.addEventListener(
"click",
function(){

if(
selectedCities.length === 0
){

return;

}

if(
confirm(
"Remove all selected cities?"
)
){

selectedCities = [];

updateSelectedCities();

}

}
);


loadCities();

updateSelectedCities();

</script>

</body>
</html>
