.letter-btn {
    min-height: 58px;
    border: 2px solid #ccc;
    border-radius: 12px;
    background: white;
    font-size: 20px;
    font-weight: 800;
    cursor: pointer;
}

.letter-btn.active {
    color: white;
    background: #087443;
    border-color: #087443;
}

.letter-btn:active {
    transform: scale(.97);
}

.results-title {
    font-weight: 800;
    font-size: 19px;
    margin-bottom: 10px;
}

.city-box {
    border: 2px solid #d9e2dd;
    border-radius: 14px;
    max-height: 380px;
    overflow-y: auto;
    background: #fbfdfc;
}

.city-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px;
    border-bottom: 1px solid #e3e3e3;
    cursor: pointer;
}

.city-row:last-child {
    border-bottom: 0;
}

.city-row:hover {
    background: #eef8f2;
}

.city-row input {
    width: 23px;
