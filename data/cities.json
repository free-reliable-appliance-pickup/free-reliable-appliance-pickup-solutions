<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Appliance Pickup Partner Network | Free Reliable Appliance Pickup</title>

<meta name="description" content="Join the Free Reliable Appliance Pickup partner network. Select the cities and ZIP codes where you provide appliance pickup service.">

<meta name="robots" content="index, follow">

<style>
* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: #f5f7f5;
    color: #222;
    line-height: 1.5;
}

header {
    background: linear-gradient(135deg, #075c35, #0a814b);
    color: white;
    text-align: center;
    padding: 42px 18px;
}

header h1 {
    margin: 0 0 10px;
    font-size: 34px;
}

header p {
    max-width: 760px;
    margin: auto;
    font-size: 17px;
}

.container {
    width: 94%;
    max-width: 1000px;
    margin: 28px auto;
}

.card {
    background: white;
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 22px;
    box-shadow: 0 2px 10px rgba(0,0,0,.08);
}

h2 {
    color: #075c35;
    margin-top: 0;
}

label {
    display: block;
    font-weight: bold;
    margin: 15px 0 6px;
}

input,
select,
textarea {
    width: 100%;
    padding: 13px;
    border: 1px solid #bbb;
    border-radius: 7px;
    font-size: 16px;
    background: white;
}

input:focus,
select:focus,
textarea:focus {
    outline: 2px solid #0a814b;
    border-color: #0a814b;
}

.grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.help {
    font-size: 14px;
    color: #666;
    margin-top: 6px;
}

.alphabet {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 18px 0;
}

.letter {
    border: 1px solid #0a814b;
    background: white;
    color: #075c35;
    width: 38px;
    height: 38px;
    border-radius: 6px;
    font-weight: bold;
    cursor: pointer;
}

.letter:hover,
.letter.active {
    background: #075c35;
    color: white;
}

.results-title {
    font-weight: bold;
    font-size: 17px;
    margin: 15px 0 8px;
    color: #333;
}

.city-results {
    border: 1px solid #ccc;
    background: #fafafa;
    border-radius: 8px;
    min-height: 130px;
    max-height: 330px;
    overflow-y: auto;
    padding: 10px;
}

.city-option {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 8px;
    border-bottom: 1px solid #e4e4e4;
    cursor: pointer;
}

.city-option:last-child {
    border-bottom: none;
}

.city-option:hover {
    background: #edf8f1;
}

.city-option input {
    width: auto;
    transform: scale(1.25);
}

.no-results {
    padding: 22px 10px;
    text-align: center;
    color: #666;
}

.action-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 12px;
}

.small-btn {
    border: none;
    padding: 11px 15px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
}

.select-btn {
    background: #075c35;
    color: white;
}

.clear-btn {
    background: #eee;
    color: #333;
}

.manual-box {
    background: #f3faf6;
    border: 1px solid #b9ddc8;
    border-radius: 8px;
    padding: 16px;
    margin-top: 18px;
}

.manual-row {
    display: grid;
    grid-template-columns: 2fr 1fr auto;
    gap: 8px;
}

.add-btn {
    background: #075c35;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 0 18px;
    font-weight: bold;
    cursor: pointer;
}

.selected-box {
    margin-top: 20px;
    padding: 15px;
    border: 1px solid #cfcfcf;
    border-radius: 8px;
    background: #fff;
}

.selected-count {
    font-weight: bold;
    color: #075c35;
    margin-bottom: 10px;
}

.selected-cities {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
}

.city-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #e4f4ea;
    color: #075c35;
    padding: 8px 10px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: bold;
}

.city-chip button {
    border: none;
    background: transparent;
    color: #a00000;
    font-weight: bold;
    cursor: pointer;
    font-size: 17px;
    padding: 0;
}

.preview {
    background: #f5f5f5;
    border-left: 5px solid #075c35;
    padding: 17px;
    border-radius: 6px;
}

.preview strong {
    color: #075c35;
}

.submit-btn {
    width: 100%;
    border: none;
    background: #075c35;
    color: white;
    font-size: 18px;
    font-weight: bold;
    padding: 16px;
    border-radius: 8px;
    cursor: pointer;
    margin-top: 18px;
}

.submit-btn:hover {
    background: #064b2c;
}

.copy-btn {
    width: 100%;
    border: 1px solid #075c35;
    background: white;
    color: #075c35;
    font-size: 16px;
    font-weight: bold;
    padding: 13px;
    border-radius: 8px;
    cursor: pointer;
    margin-top: 10px;
    display: none;
}

.status {
    display: none;
    margin-top: 15px;
    padding: 14px;
    border-radius: 7px;
    font-weight: bold;
}

.status.success {
    display: block;
    background: #e4f4ea;
    color: #075c35;
}

.status.error {
    display: block;
    background: #ffe7e7;
    color: #9a0000;
}

footer {
    text-align: center;
    padding: 30px 15px;
    color: #666;
    font-size: 14px;
}

@media(max-width:700px) {

    header h1 {
        font-size: 28px;
    }

    .grid {
        grid-template-columns: 1fr;
    }

    .manual-row {
        grid-template-columns: 1fr;
    }

    .add-btn {
        padding: 13px;
    }

    .card {
        padding: 18px;
    }
}
</style>
</head>

<body>

<header>
    <h1>Appliance Pickup Partner Network</h1>
    <p>
        Join Free Reliable Appliance Pickup and choose the cities and ZIP codes
        where you provide appliance pickup service.
    </p>
</header>

<div class="container">

<div class="card">

<h2>Partner Information</h2>

<div class="grid">

<div>
<label for="fullName">Full Name *</label>
<input id="fullName" type="text" autocomplete="name">
</div>

<div>
<label for="businessName">Business Name</label>
<input id="businessName" type="text" placeholder="Optional">
</div>

<div>
<label for="email">Email *</label>
<input id="email" type="email" autocomplete="email">
</div>

<div>
<label for="phone">Phone *</label>
<input id="phone" type="tel" autocomplete="tel">
</div>

</div>

</div>


<div class="card">

<h2>Select Your Service Areas</h2>

<label for="stateSelect">State *</label>

<select id="stateSelect">
<option value="">Select a state</option>
<option value="AL">Alabama</option>
<option value="AK">Alaska</option>
<option value="AZ">Arizona</option>
<option value="AR">Arkansas</option>
<option value="CA">California</option>
<option value="CO">Colorado</option>
<option value="CT">Connecticut</option>
<option value="DE">Delaware</option>
<option value="DC">Washington, DC</option>
<option value="FL">Florida</option>
<option value="GA">Georgia</option>
<option value="HI">Hawaii</option>
<option value="ID">Idaho</option>
<option value="IL">Illinois</option>
<option value="IN">Indiana</option>
<option value="IA">Iowa</option>
<option value="KS">Kansas</option>
<option value="KY">Kentucky</option>
<option value="LA">Louisiana</option>
<option value="ME">Maine</option>
<option value="MD">Maryland</option>
<option value="MA">Massachusetts</option>
<option value="MI">Michigan</option>
<option value="MN">Minnesota</option>
<option value="MS">Mississippi</option>
<option value="MO">Missouri</option>
<option value="MT">Montana</option>
<option value="NE">Nebraska</option>
<option value="NV">Nevada</option>
<option value="NH">New Hampshire</option>
<option value="NJ">New Jersey</option>
<option value="NM">New Mexico</option>
<option value="NY">New York</option>
<option value="NC">North Carolina</option>
<option value="ND">North Dakota</option>
<option value="OH">Ohio</option>
<option value="OK">Oklahoma</option>
<option value="OR">Oregon</option>
<option value="PA">Pennsylvania</option>
<option value="RI">Rhode Island</option>
<option value="SC">South Carolina</option>
<option value="SD">South Dakota</option>
<option value="TN">Tennessee</option>
<option value="TX">Texas</option>
<option value="UT">Utah</option>
<option value="VT">Vermont</option>
<option value="VA">Virginia</option>
<option value="WA">Washington</option>
<option value="WV">West Virginia</option>
<option value="WI">Wisconsin</option>
<option value="WY">Wyoming</option>
</select>


<label for="citySearch">Search City or ZIP Code</label>

<input
id="citySearch"
type="text"
placeholder="Example: San Dimas or 91748"
>

<div class="help">
Search the loaded city database, or use A–Z below.
</div>


<div class="alphabet" id="alphabet"></div>

<div class="results-title" id="resultsTitle">
Select a state and choose a letter
</div>

<div class="city-results" id="cityResults">
<div class="no-results">
Select a state above to begin.
</div>
</div>


<div class="action-row">

<button
type="button"
class="small-btn select-btn"
id="selectVisibleBtn">
Select Visible Cities
</button>

<button
type="button"
class="small-btn clear-btn"
id="clearStateBtn">
Clear This State
</button>

</div>


<div class="manual-box">

<strong>City or ZIP not listed?</strong>

<div class="help">
Add the city manually. You can also include a ZIP code.
</div>

<div class="manual-row">

<input
id="manualCity"
type="text"
placeholder="City name">

<input
id="manualZip"
type="text"
inputmode="numeric"
maxlength="5"
placeholder="ZIP code">

<button
type="button"
class="add-btn"
id="manualAddBtn">
Add
</button>

</div>

</div>


<div class="selected-box">

<div class="selected-count" id="selectedCount">
0 service areas selected
</div>

<div class="selected-cities" id="selectedCities"></div>

</div>

</div>


<div class="card">

<h2>How Partner Leads Work</h2>

<div class="preview">

<strong>Lead Preview</strong>

<p>
Partners may receive information such as appliance type,
condition, photos and general service area.
</p>

<p>
Private customer information such as full address,
phone number and email can remain protected until the
lead is assigned or unlocked.
</p>

</div>

<p>
Coverage selections tell us where you are available to
pick up refrigerators, washers, dryers, stoves, ranges,
freezers and other qualifying major appliances.
</p>

<p>
Some markets may later offer exclusive or premium territory
options based on actual lead volume and availability.
</p>

</div>


<div class="card">

<h2>Submit Partner Application</h2>

<p>
Review your information and service areas before submitting.
</p>

<button
type="button"
class="submit-btn"
id="submitBtn">
Submit Partner Application
</button>

<button
type="button"
class="copy-btn"
id="copyBtn">
Copy Application
</button>

<div id="status" class="status"></div>

</div>

</div>


<footer>
© Free Reliable Appliance Pickup
</footer>


<script>

const STATE_NAMES = {
AL:"Alabama",
AK:"Alaska",
AZ:"Arizona",
AR:"Arkansas",
CA:"California",
CO:"Colorado",
CT:"Connecticut",
DE:"Delaware",
DC:"Washington, DC",
FL:"Florida",
GA:"Georgia",
HI:"Hawaii",
ID:"Idaho",
IL:"Illinois",
IN:"Indiana",
IA:"Iowa",
KS:"Kansas",
KY:"Kentucky",
LA:"Louisiana",
ME:"Maine",
MD:"Maryland",
MA:"Massachusetts",
MI:"Michigan",
MN:"Minnesota",
MS:"Mississippi",
MO:"Missouri",
MT:"Montana",
NE:"Nebraska",
NV:"Nevada",
NH:"New Hampshire",
NJ:"New Jersey",
NM:"New Mexico",
NY:"New York",
NC:"North Carolina",
ND:"North Dakota",
OH:"Ohio",
OK:"Oklahoma",
OR:"Oregon",
PA:"Pennsylvania",
RI:"Rhode Island",
SC:"South Carolina",
SD:"South Dakota",
TN:"Tennessee",
TX:"Texas",
UT:"Utah",
VT:"Vermont",
VA:"Virginia",
WA:"Washington",
WV:"West Virginia",
WI:"Wisconsin",
WY:"Wyoming"
};


let cityDatabase = [];
let selectedAreas = [];
let currentLetter = "";
let visibleCities = [];
let lastApplicationText = "";


const stateSelect =
document.getElementById("stateSelect");

const citySearch =
document.getElementById("citySearch");

const cityResults =
document.getElementById("cityResults");

const resultsTitle =
document.getElementById("resultsTitle");

const alphabet =
document.getElementById("alphabet");

const selectedCities =
document.getElementById("selectedCities");

const selectedCount =
document.getElementById("selectedCount");

const manualCity =
document.getElementById("manualCity");

const manualZip =
document.getElementById("manualZip");

const statusBox =
document.getElementById("status");

const copyBtn =
document.getElementById("copyBtn");


/* --------------------------------
   LOAD CITY DATABASE
-------------------------------- */

async function loadCities() {

    try {

        const response =
        await fetch("../data/cities.json?v=" + Date.now());

        if (!response.ok) {
            throw new Error("City database could not be loaded.");
        }

        const data = await response.json();

        if (!Array.isArray(data)) {
            throw new Error("Invalid city database.");
        }

        cityDatabase = data.sort((a,b) => {

            if (a.state !== b.state) {
                return a.state.localeCompare(b.state);
            }

            return a.city.localeCompare(b.city);

        });

    }

    catch(error) {

        console.error(error);

        cityDatabase = [];

    }

}


/* --------------------------------
   BUILD A-Z
-------------------------------- */

function buildAlphabet() {

    alphabet.innerHTML = "";

    "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    .split("")
    .forEach(letter => {

        const button =
        document.createElement("button");

        button.type = "button";

        button.className = "letter";

        button.textContent = letter;

        button.dataset.letter = letter;

        button.addEventListener("click", () => {

            currentLetter = letter;

            citySearch.value = "";

            document
            .querySelectorAll(".letter")
            .forEach(btn => {
                btn.classList.remove("active");
            });

            button.classList.add("active");

            renderLetterCities();

        });

        alphabet.appendChild(button);

    });

}


/* --------------------------------
   STATE CITIES
-------------------------------- */

function getStateCities() {

    const state = stateSelect.value;

    return cityDatabase.filter(
        item => item.state === state
    );

}


/* --------------------------------
   LETTER RESULTS
-------------------------------- */

function renderLetterCities() {

    const state = stateSelect.value;

    if (!state) {

        visibleCities = [];

        resultsTitle.textContent =
        "Select a state first";

        cityResults.innerHTML =
        '<div class="no-results">Select a state above to begin.</div>';

        return;

    }

    if (!currentLetter) {

        visibleCities = [];

        resultsTitle.textContent =
        "Choose a letter A–Z";

        cityResults.innerHTML =
        '<div class="no-results">Choose a letter or search for a city.</div>';

        return;

    }

    visibleCities =
    getStateCities().filter(item =>
        item.city
        .toUpperCase()
        .startsWith(currentLetter)
    );

    const stateName =
    STATE_NAMES[state] || state;

    resultsTitle.textContent =
    currentLetter +
    " Cities in " +
    stateName +
    " — " +
    visibleCities.length +
    " available";

    renderCityList(visibleCities);

}


/* --------------------------------
   SEARCH
-------------------------------- */

function searchCities() {

    const query =
    citySearch.value.trim().toLowerCase();

    const state =
    stateSelect.value;

    document
    .querySelectorAll(".letter")
    .forEach(btn => {
        btn.classList.remove("active");
    });

    currentLetter = "";

    if (!state) {

        resultsTitle.textContent =
        "Select a state first";

        cityResults.innerHTML =
        '<div class="no-results">Select the state where you provide service.</div>';

        return;

    }

    if (!query) {

        visibleCities = [];

        resultsTitle.textContent =
        "Choose a letter A–Z";

        cityResults.innerHTML =
        '<div class="no-results">Choose a letter or search for a city or ZIP code.</div>';

        return;

    }

    visibleCities =
    getStateCities().filter(item => {

        const cityMatch =
        item.city
        .toLowerCase()
        .includes(query);

        const zips =
        Array.isArray(item.zip_codes)
        ? item.zip_codes
        : [];

        const zipMatch =
        zips.some(zip =>
            String(zip).includes(query)
        );

        return cityMatch || zipMatch;

    });

    resultsTitle.textContent =
    'Search results for "' +
    citySearch.value.trim() +
    '" — ' +
    visibleCities.length +
    " found";

    renderCityList(visibleCities);

}


/* --------------------------------
   CITY RESULTS
-------------------------------- */

function renderCityList(cities) {

    cityResults.innerHTML = "";

    if (!cities.length) {

        cityResults.innerHTML = `
        <div class="no-results">
        No matching cities are currently loaded.<br><br>
        You can add the city manually below.
        </div>
        `;

        return;

    }

    cities.forEach(item => {

        const row =
        document.createElement("label");

        row.className = "city-option";

        const checkbox =
        document.createElement("input");

        checkbox.type = "checkbox";

        checkbox.checked =
        isAreaSelected(
            item.state,
            item.city
        );

        checkbox.addEventListener(
            "change",
            () => {

                if (checkbox.checked) {

                    addArea({
                        state: item.state,
                        city: item.city,
                        zip: ""
                    });

                } else {

                    removeArea(
                        item.state,
                        item.city
                    );

                }

            }
        );

        const text =
        document.createElement("span");

        text.textContent =
        item.city +
        ", " +
        item.state;

        row.appendChild(checkbox);
        row.appendChild(text);

        cityResults.appendChild(row);

    });

}


/* --------------------------------
   SELECTED AREAS
-------------------------------- */

function areaKey(state, city) {

    return (
        state.trim().toUpperCase() +
        "|" +
        city.trim().toLowerCase()
    );

}


function isAreaSelected(state, city) {

    const key =
    areaKey(state, city);

    return selectedAreas.some(
        area =>
        areaKey(area.state, area.city) === key
    );

}


function addArea(area) {

    const state =
    area.state.trim().toUpperCase();

    const city =
    area.city.trim();

    const zip =
    (area.zip || "").trim();

    if (!state || !city) {
        return;
    }

    const existing =
    selectedAreas.find(
        item =>
        areaKey(item.state, item.city) ===
        areaKey(state, city)
    );

    if (existing) {

        if (zip && !existing.zip) {
            existing.zip = zip;
        }

    } else {

        selectedAreas.push({
            state,
            city,
            zip
        });

    }

    saveSelections();

    renderSelectedAreas();

}


function removeArea(state, city) {

    selectedAreas =
    selectedAreas.filter(
        area =>
        areaKey(area.state, area.city) !==
        areaKey(state, city)
    );

    saveSelections();

    renderSelectedAreas();

    if (citySearch.value.trim()) {
        searchCities();
    } else if (currentLetter) {
        renderLetterCities();
    }

}


function renderSelectedAreas() {

    selectedCities.innerHTML = "";

    selectedAreas.sort((a,b) => {

        if (a.state !== b.state) {
            return a.state.localeCompare(b.state);
        }

        return a.city.localeCompare(b.city);

    });

    selectedCount.textContent =
    selectedAreas.length +
    (
        selectedAreas.length === 1
        ? " service area selected"
        : " service areas selected"
    );

    if (!selectedAreas.length) {

        selectedCities.innerHTML =
        '<span class="help">No service areas selected yet.</span>';

        return;

    }

    selectedAreas.forEach(area => {

        const chip =
        document.createElement("span");

        chip.className = "city-chip";

        let label =
        area.city + ", " + area.state;

        if (area.zip) {
            label += " " + area.zip;
        }

        const text =
        document.createElement("span");

        text.textContent = label;

        const remove =
        document.createElement("button");

        remove.type = "button";

        remove.textContent = "×";

        remove.setAttribute(
            "aria-label",
            "Remove " + label
        );

        remove.addEventListener(
            "click",
            () => {
                removeArea(
                    area.state,
                    area.city
                );
            }
        );

        chip.appendChild(text);
        chip.appendChild(remove);

        selectedCities.appendChild(chip);

    });

}


/* --------------------------------
   LOCAL BACKUP
-------------------------------- */

function saveSelections() {

    localStorage.setItem(
        "partnerSelectedAreas",
        JSON.stringify(selectedAreas)
    );

}


function restoreSelections() {

    try {

        const saved =
        JSON.parse(
            localStorage.getItem(
                "partnerSelectedAreas"
            ) || "[]"
        );

        if (Array.isArray(saved)) {
            selectedAreas = saved;
        }

    }

    catch(error) {

        selectedAreas = [];

    }

    renderSelectedAreas();

}


/* --------------------------------
   MANUAL CITY
-------------------------------- */

function addManualCity() {

    const state =
    stateSelect.value;

    const city =
    manualCity.value.trim();

    const zip =
    manualZip.value.trim();

    if (!state) {

        showStatus(
            "Please select a state first.",
            "error"
        );

        return;

    }

    if (!city) {

        showStatus(
            "Enter the city name.",
            "error"
        );

        return;

    }

    if (zip && !/^\d{5}$/.test(zip)) {

        showStatus(
            "ZIP code must contain 5 numbers.",
            "error"
        );

        return;

    }

    addArea({
        state,
        city,
        zip
    });

    manualCity.value = "";
    manualZip.value = "";

    showStatus(
        city +
        ", " +
        state +
        " was added to your service areas.",
        "success"
    );

}


/* --------------------------------
   SELECT VISIBLE
-------------------------------- */

function selectVisibleCities() {

    if (!visibleCities.length) {

        showStatus(
            "There are no visible cities to select.",
            "error"
        );

        return;

    }

    visibleCities.forEach(item => {

        addArea({
            state: item.state,
            city: item.city,
            zip: ""
        });

    });

    if (citySearch.value.trim()) {
        searchCities();
    } else {
        renderLetterCities();
    }

    showStatus(
        visibleCities.length +
        " visible cities selected.",
        "success"
    );

}


/* --------------------------------
   CLEAR STATE
-------------------------------- */

function clearCurrentState() {

    const state =
    stateSelect.value;

    if (!state) {

        showStatus(
            "Select a state first.",
            "error"
        );

        return;

    }

    selectedAreas =
    selectedAreas.filter(
        area => area.state !== state
    );

    saveSelections();

    renderSelectedAreas();

    if (citySearch.value.trim()) {
        searchCities();
    } else if (currentLetter) {
        renderLetterCities();
    }

    showStatus(
        "Selections for " +
        STATE_NAMES[state] +
        " were cleared.",
        "success"
    );

}


/* --------------------------------
   STATUS
-------------------------------- */

function showStatus(message, type) {

    statusBox.textContent = message;

    statusBox.className =
    "status " + type;

}


/* --------------------------------
   APPLICATION
-------------------------------- */

function buildApplication() {

    const fullName =
    document
    .getElementById("fullName")
    .value
    .trim();

    const businessName =
    document
    .getElementById("businessName")
    .value
    .trim();

    const email =
    document
    .getElementById("email")
    .value
    .trim();

    const phone =
    document
    .getElementById("phone")
    .value
    .trim();

    if (!fullName) {

        showStatus(
            "Please enter your full name.",
            "error"
        );

        return null;

    }

    if (!email) {

        showStatus(
            "Please enter your email.",
            "error"
        );

        return null;

    }

    if (!phone) {

        showStatus(
            "Please enter your phone number.",
            "error"
        );

        return null;

    }

    if (!selectedAreas.length) {

        showStatus(
            "Please select at least one service area.",
            "error"
        );

        return null;

    }

    const coverage =
    selectedAreas
    .map(area => {

        let text =
        area.city +
        ", " +
        area.state;

        if (area.zip) {
            text += " " + area.zip;
        }

        return "- " + text;

    })
    .join("\n");


    const application = {
        fullName,
        businessName,
        email,
        phone,
        serviceAreas: selectedAreas,
        submittedAt:
        new Date().toISOString()
    };


    localStorage.setItem(
        "pendingPartnerSignup",
        JSON.stringify(application)
    );


    const text =

`NEW PARTNER APPLICATION

Free Reliable Appliance Pickup

Name: ${fullName}

Business: ${businessName || "Not provided"}

Email: ${email}

Phone: ${phone}

SERVICE AREAS

${coverage}

Number of selected service areas:
${selectedAreas.length}

Application Date:
${new Date().toLocaleString()}
`;

    return text;

}


/* --------------------------------
   SUBMIT
-------------------------------- */

function submitApplication() {

    const applicationText =
    buildApplication();

    if (!applicationText) {
        return;
    }

    lastApplicationText =
    applicationText;

    copyBtn.style.display = "block";

    const subject =
    "New Appliance Pickup Partner Application";

    const destination =
    "freereliableappliancepickup@gmail.com";

    const mailto =
    "mailto:" +
    destination +
    "?subject=" +
    encodeURIComponent(subject) +
    "&body=" +
    encodeURIComponent(applicationText);

    showStatus(
        "Your application is ready. Your email app should open with the application prepared. Send the email to complete the application.",
        "success"
    );

    window.location.href = mailto;

}


/* --------------------------------
   COPY FALLBACK
-------------------------------- */

async function copyApplication() {

    if (!lastApplicationText) {

        const text =
        buildApplication();

        if (!text) {
            return;
        }

        lastApplicationText = text;

    }

    try {

        await navigator.clipboard.writeText(
            lastApplicationText
        );

        showStatus(
            "Application copied. You can paste it into an email or message.",
            "success"
        );

    }

    catch(error) {

        showStatus(
            "Your browser could not copy automatically. Please use the email submission button.",
            "error"
        );

    }

}


/* --------------------------------
   EVENTS
-------------------------------- */

stateSelect.addEventListener(
    "change",
    () => {

        currentLetter = "";

        citySearch.value = "";

        document
        .querySelectorAll(".letter")
        .forEach(btn => {
            btn.classList.remove("active");
        });

        const state =
        stateSelect.value;

        if (!state) {

            resultsTitle.textContent =
            "Select a state and choose a letter";

            cityResults.innerHTML =
            '<div class="no-results">Select a state above to begin.</div>';

            return;

        }

        const count =
        getStateCities().length;

        resultsTitle.textContent =
        STATE_NAMES[state] +
        " — " +
        count +
        " cities currently loaded";

        cityResults.innerHTML =
        '<div class="no-results">Choose a letter A–Z or search for a city.</div>';

    });


citySearch.addEventListener(
    "input",
    searchCities
);


document
.getElementById("manualAddBtn")
.addEventListener(
    "click",
    addManualCity
);


document
.getElementById("selectVisibleBtn")
.addEventListener(
    "click",
    selectVisibleCities
);


document
.getElementById("clearStateBtn")
.addEventListener(
    "click",
    clearCurrentState
);


document
.getElementById("submitBtn")
.addEventListener(
    "click",
    submitApplication
);


copyBtn.addEventListener(
    "click",
    copyApplication
);


manualCity.addEventListener(
    "keydown",
    event => {

        if (event.key === "Enter") {
            addManualCity();
        }

    }
);


/* --------------------------------
   START
-------------------------------- */

async function start() {

    buildAlphabet();

    restoreSelections();

    await loadCities();

}

start();

</script>

</body>
</html>
