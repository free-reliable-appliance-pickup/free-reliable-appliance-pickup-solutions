---
import { locationPages } from "../data/locations";
import PickupRequestForm from "../components/PickupRequestForm.astro";

export const prerender = true;

export function getStaticPaths() {
  return locationPages.map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}

const { page } = Astro.props;
const isLaundry = page.slug.endsWith("-washer-dryer-pickup");
const serviceLabel = isLaundry ? "Washer & Dryer Pickup" : "Appliance Pickup & Removal";
const liveSite = "https://freereliableappliancepickup.com";
const heroImageUrl = `${liveSite}${page.heroImage}`;
const marketHubUrl = `${liveSite}${page.marketHubHref}`;
const absoluteHref = (href: string) => href.startsWith("/") ? `${liveSite}${href}` : href;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: `${serviceLabel} in ${page.city}, ${page.state}`,
  serviceType: isLaundry
    ? ["Washer Pickup", "Dryer Pickup", "Laundry Appliance Removal", "Appliance Recycling Review"]
    : [
        "Appliance Pickup",
        "Appliance Removal",
        "Appliance Recycling Review",
        "Washer Pickup",
        "Dryer Pickup",
        "Refrigerator Pickup",
        "Freezer Pickup",
        "Stove Pickup",
        "Range Pickup",
        "Oven Pickup"
      ],
  provider: {
    "@id": `${liveSite}/#organization`
  },
  telephone: page.phoneE164,
  areaServed: {
    "@type": "City",
    name: page.city,
    containedInPlace: {
      "@type": "AdministrativeArea",
      name: page.county,
      containedInPlace: {
        "@type": "AdministrativeArea",
        name: page.state
      }
    }
  },
  url: page.canonical,
  image: heroImageUrl
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${liveSite}/#organization`,
  name: "Free Reliable Appliance Pickup",
  alternateName: ["Free Appliance Pickup Across USA", "Reliable Appliance Pickup"],
  url: `${liveSite}/`
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${page.canonical}#webpage`,
  url: page.canonical,
  name: page.title,
  description: page.description,
  isPartOf: { "@id": `${liveSite}/#website` },
  primaryImageOfPage: {
    "@type": "ImageObject",
    "@id": `${page.canonical}#primaryimage`,
    url: heroImageUrl,
    contentUrl: heroImageUrl,
    caption: page.heroImageAlt,
    representativeOfPage: true
  },
  mainEntity: {
    "@type": "Service",
    name: `${serviceLabel} in ${page.city}, ${page.state}`,
    url: page.canonical
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: page.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer
    }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${liveSite}/` },
    { "@type": "ListItem", position: 2, name: "Service Areas", item: `${liveSite}/service-areas/` },
    { "@type": "ListItem", position: 3, name: "California", item: `${liveSite}/california-appliance-pickup/` },
    { "@type": "ListItem", position: 4, name: page.market, item: marketHubUrl },
    {
      "@type": "ListItem",
      position: 5,
      name: `${page.city} ${isLaundry ? "Washer & Dryer Pickup" : "Appliance Pickup"}`,
      item: page.canonical
    }
  ]
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={page.canonical} />
    <link rel="preconnect" href={liveSite} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Free Reliable Appliance Pickup" />
    <meta property="og:url" content={page.canonical} />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:image" content={heroImageUrl} />
    <meta property="og:image:alt" content={page.heroImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.title} />
    <meta name="twitter:description" content={page.description} />
    <meta name="twitter:image" content={heroImageUrl} />
    <link rel="icon" href={`${liveSite}/favicon-refrigerator.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <style>
      :root{font-family:Arial,Helvetica,sans-serif;color:#17352a;background:#f5f7f6}
      *{box-sizing:border-box}body{margin:0;line-height:1.65;background:#f5f7f6;color:#24332d}
      a{color:#07683d}header{background:#fff;border-bottom:1px solid #d7e5dc;position:sticky;top:0;z-index:5}
      .bar{max-width:1100px;margin:auto;padding:14px 20px;display:flex;gap:18px;align-items:center;justify-content:space-between}
      .brand{font-weight:800;text-decoration:none;color:#17352a}.brand span{color:#087443}
      nav{display:flex;gap:14px;flex-wrap:wrap}nav a{font-weight:700;text-decoration:none}
      main{max-width:1100px;margin:auto;padding:0 20px 48px}.crumb{font-size:14px;padding:16px 0}
      section{background:#fff;margin:18px 0;padding:26px;border:1px solid #d7e5dc;border-radius:16px}
      .hero{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(280px,.9fr);gap:26px;align-items:center}
      .hero h1{font-size:clamp(32px,5vw,54px);line-height:1.05;margin:0 0 14px;color:#075c34}
      .hero img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:14px}
      .cta{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.btn{display:inline-block;padding:12px 16px;border-radius:10px;background:#087443;color:#fff;text-decoration:none;font-weight:800}
      .btn.alt{background:#eef8f2;color:#075c34;border:1px solid #b8d7c5}
      .note{background:#eef8f2;border-left:5px solid #087443;padding:14px;border-radius:8px}
      .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}.card{border:1px solid #d7e5dc;border-radius:12px;padding:16px;background:#fbfdfc}
      h2{color:#075c34;margin-top:0}h3{color:#17352a}.link-list{display:flex;flex-wrap:wrap;gap:10px;padding:0;list-style:none}.link-list a{display:block;padding:10px 12px;border-radius:9px;background:#eef8f2;text-decoration:none;font-weight:700}
      footer{background:#17352a;color:#fff;text-align:center;padding:28px 20px}footer a{color:#fff}
      @media(max-width:760px){header{position:static}.bar{display:block}.bar nav{margin-top:10px}.hero{grid-template-columns:1fr}section{padding:20px}.hero img{order:-1}}
    </style>
  </head>
  <body>
    <header>
      <div class="bar">
        <a class="brand" href="/">Free Reliable <span>Appliance Pickup</span></a>
        <nav aria-label="Main navigation">
          <a href={`${liveSite}/how-appliance-pickup-works/`}>How It Works</a>
          <a href={`${liveSite}/service-areas/`}>Service Areas</a>
          <a href={`${liveSite}/free-pickup-qualification/`}>Qualifications</a>
          <a href="#request">Request Pickup</a>
        </nav>
      </div>
    </header>

    <main>
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">V2 Home</a> ›
        <a href={`${liveSite}/california-appliance-pickup/`}>{page.state}</a> ›
        <a href={marketHubUrl}>{page.market}</a> ›
        <span>{page.city}</span>
      </nav>

      <section class="hero">
        <div>
          <p><strong>{page.market}</strong> · {page.county}</p>
          <h1>{isLaundry ? "Free Washer & Dryer Pickup" : "Free Appliance Pickup & Removal"} in {page.city}, {page.stateCode}</h1>
          <p>{page.serviceSummary}</p>
          <p><strong>{page.hours}</strong> · English / Español</p>
          <div class="cta">
            <a class="btn" href={`tel:${page.phoneE164}`}>Call {page.phoneDisplay}</a>
            <a class="btn alt" href={`sms:${page.phoneE164}`}>Text Appliance Photos</a>
            <a class="btn alt" href="#request">Request Pickup</a>
          </div>
          <p class="note"><strong>Free to submit · No account required.</strong> Pickup is confirmed only after qualification and route review.</p>
        </div>
        <img src={heroImageUrl} alt={page.heroImageAlt} width="768" height="576" loading="eager" fetchpriority="high" />
      </section>

      <section>
        <h2>How Pickup Works in {page.city}</h2>
        <div class="grid">
          <div class="card">
            <h3>1. Send the request</h3>
            <p>Tell us the appliance type, working condition, exact city or ZIP code and removal access. Photos help when available.</p>
          </div>
          <div class="card">
            <h3>2. Qualification & local match</h3>
            <p>We review condition, access and current local coverage. Eligible requests can be matched to an approved local pickup partner or active route.</p>
          </div>
          <div class="card">
            <h3>3. Confirm before pickup</h3>
            <p>Pickup details are confirmed before anyone is dispatched. Submitting the request does not automatically guarantee free pickup.</p>
          </div>
        </div>
      </section>

      <section>
        <h2>Free-Pickup Qualification</h2>
        <p>{page.qualificationSummary}</p>
      </section>

      <section>
        <h2>{isLaundry ? "Washer & Dryer Testing Before Pickup" : "Appliance Testing Before Pickup"}</h2>
        {isLaundry ? (
          <div class="grid">
            <div class="card"><h3>Washer</h3><p>Report whether it powers on, fills, agitates or washes, drains and spins. Mention leaks, error codes or unusual noise.</p></div>
            <div class="card"><h3>Dryer</h3><p>Report whether it powers on, tumbles and heats. Include whether it is gas or electric and any known error or noise.</p></div>
            <div class="card"><h3>Matching set</h3><p>Tell us whether both machines work and whether they can be tested before pickup. Complete working sets receive priority review.</p></div>
          </div>
        ) : (
          <div class="grid">
            <div class="card"><h3>Refrigerator / freezer</h3><p>Report whether it is currently cooling or freezing and whether it can be tested. Interior and model-label photos are especially useful.</p></div>
            <div class="card"><h3>Washer / dryer</h3><p>For washers, report fill, wash, drain and spin. For dryers, report tumble and heat. A matching working set can be especially useful for reuse.</p></div>
            <div class="card"><h3>Stove / range / oven</h3><p>Report gas or electric type, approximate width and which burners or oven functions work. Do not disconnect gas service unless it can be done safely by an appropriate person.</p></div>
          </div>
        )}
        <p class="note">Testing information helps qualification, but it does not guarantee free pickup. Condition, access, exact address and current route capacity are reviewed together.</p>
      </section>

      <section>
        <h2>Access Details That Prevent a Failed Pickup</h2>
        <div class="grid">
          <div class="card"><h3>Exact location</h3><p>Use the real pickup address and ZIP. Tell us whether the appliance is in a garage, driveway, inside the property, upstairs, behind a gate or in a loading area.</p></div>
          <div class="card"><h3>Removal path</h3><p>Include stairs, elevator rules, narrow doors, long carries, sloped driveways and gate or HOA access that could affect safe removal.</p></div>
          <div class="card"><h3>Parking & timing</h3><p>Note loading restrictions, building hours, delivery deadlines or preferred pickup windows. A requested time is reviewed, not automatically guaranteed.</p></div>
        </div>
      </section>

      <section>
        <h2>{page.city} Local Route Context</h2>
        <p>{page.localContext}</p>
      </section>

      <section>
        <h2>{isLaundry ? "Washer & Dryer Pickup Options" : "Appliance Pickup Options"} in {page.city}</h2>
        <ul class="link-list">
          {page.applianceLinks.map((item) => (
            <li><a href={absoluteHref(item.href)}>{item.label}</a></li>
          ))}
        </ul>
      </section>

      {(page.neighborhoods.length > 0 || page.zipCodes.length > 0) && (
        <section>
          <h2>{page.city} Local Coverage Details</h2>
          <div class="grid">
            {page.neighborhoods.length > 0 && (
              <div class="card"><h3>Local areas</h3><p>{page.neighborhoods.join(", ")}.</p></div>
            )}
            {page.zipCodes.length > 0 && (
              <div class="card"><h3>Common ZIP codes</h3><p>{page.zipCodes.join(", ")}.</p></div>
            )}
          </div>
          <p>Use the actual pickup address rather than a nearby city name. Exact access, appliance condition and route direction are reviewed before pickup is confirmed.</p>
        </section>
      )}

      <section>
        <h2>Nearby {isLaundry ? "Washer & Dryer" : "Appliance"} Pickup Areas</h2>
        <ul class="link-list">
          {page.nearbyLinks.map((item) => (
            <li><a href={item.href}>{item.label} {isLaundry ? "washer & dryer pickup" : "appliance pickup"}</a></li>
          ))}
        </ul>
      </section>

      <section>
        <h2>{page.city} Business, Property & Recurring Appliance Pickup</h2>
        <p>
          Property managers, senior and 55+ communities, appliance dealers, installers, multifamily operators,
          hotels and other repeat-volume organizations can submit one-time or recurring appliance replacement work for review.
          Working and reusable equipment receives priority; exact service still depends on appliance condition, access and current coverage.
        </p>
        <ul class="link-list">
          <li><a href={`${liveSite}/recurring-appliance-pickup-program/`}>Recurring pickup programs</a></li>
          <li><a href={`${liveSite}/senior-living-appliance-pickup/`}>Senior living & 55+ pickup</a></li>
          <li><a href={`${liveSite}/landlord-property-manager-appliance-pickup/`}>Property managers & multifamily</a></li>
          <li><a href={`${liveSite}/commercial-laundry-appliance-pickup/`}>Commercial washer & dryer programs</a></li>
        </ul>
      </section>

      <section>
        <h2>Local Appliance Pickup Partners</h2>
        <p>
          We are building the network with independent appliance buyers, repair/refurbishment businesses and pickup professionals.
          Partner applications are reviewed before territory access is approved, and customer contact information is not publicly displayed.
        </p>
        <div class="cta">
          <a class="btn alt" href={`${liveSite}/partners/`}>Apply to Join the Pickup Network</a>
        </div>
      </section>

      <section>
        <h2>{page.city} {isLaundry ? "Washer & Dryer Pickup" : "Appliance Pickup"} FAQ</h2>
        {page.faqs.map((faq) => (
          <article>
            <h3>{faq.question}</h3>
            <p>{faq.answer}</p>
          </article>
        ))}
      </section>

      <PickupRequestForm
        city={page.city}
        state={page.stateCode}
        market={page.market}
        sourcePage={page.canonical}
        serviceIntent={isLaundry ? "washer-dryer" : "appliance"}
      />
    </main>

    <footer>
      Free Reliable Appliance Pickup · {page.city}, California ·
      <a href={`tel:${page.phoneE164}`}>{page.phoneDisplay}</a>
    </footer>
  </body>
</html>
