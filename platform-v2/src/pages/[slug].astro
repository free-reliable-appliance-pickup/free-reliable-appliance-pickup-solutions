---
import { locationPages } from "../data/locations";
import PickupRequestForm from "../components/PickupRequestForm.astro";

export const prerender = true;

export function getStaticPaths() {
  return locationPages.map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}

const { page } = Astro.props;
const liveSite = "https://freereliableappliancepickup.com";
const heroImageUrl = `${liveSite}${page.heroImage}`;
const marketHubUrl = `${liveSite}${page.marketHubHref}`;
const absoluteHref = (href: string) => href.startsWith("/") ? `${liveSite}${href}` : href;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: `Free Appliance Pickup & Removal in ${page.city}, ${page.state}`,
  serviceType: [
    "Appliance Pickup",
    "Appliance Removal",
    "Appliance Recycling Review",
    "Washer Pickup",
    "Dryer Pickup",
    "Refrigerator Pickup",
    "Freezer Pickup",
    "Stove Pickup",
    "Range Pickup",
    "Oven Pickup"
  ],
  provider: {
    "@type": "Organization",
    name: "Free Reliable Appliance Pickup",
    url: `${liveSite}/`
  },
  telephone: page.phoneE164,
  areaServed: {
    "@type": "City",
    name: page.city,
    containedInPlace: {
      "@type": "AdministrativeArea",
      name: page.county,
      containedInPlace: {
        "@type": "AdministrativeArea",
        name: page.state
      }
    }
  },
  url: page.canonical,
  image: heroImageUrl
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: page.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer
    }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${liveSite}/` },
    { "@type": "ListItem", position: 2, name: "Service Areas", item: `${liveSite}/service-areas/` },
    { "@type": "ListItem", position: 3, name: "California", item: `${liveSite}/california-appliance-pickup/` },
    { "@type": "ListItem", position: 4, name: page.market, item: marketHubUrl },
    { "@type": "ListItem", position: 5, name: page.city, item: page.canonical }
  ]
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={page.canonical} />
    <link rel="preconnect" href={liveSite} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Free Reliable Appliance Pickup" />
    <meta property="og:url" content={page.canonical} />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:image" content={heroImageUrl} />
    <meta property="og:image:alt" content={page.heroImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <style>
      :root{font-family:Arial,Helvetica,sans-serif;color:#17352a;background:#f5f7f6}
      *{box-sizing:border-box}body{margin:0;line-height:1.65;background:#f5f7f6;color:#24332d}
      a{color:#07683d}header{background:#fff;border-bottom:1px solid #d7e5dc;position:sticky;top:0;z-index:5}
      .bar{max-width:1100px;margin:auto;padding:14px 20px;display:flex;gap:18px;align-items:center;justify-content:space-between}
      .brand{font-weight:800;text-decoration:none;color:#17352a}.brand span{color:#087443}
      nav{display:flex;gap:14px;flex-wrap:wrap}nav a{font-weight:700;text-decoration:none}
      main{max-width:1100px;margin:auto;padding:0 20px 48px}.crumb{font-size:14px;padding:16px 0}
      section{background:#fff;margin:18px 0;padding:26px;border:1px solid #d7e5dc;border-radius:16px}
      .hero{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(280px,.9fr);gap:26px;align-items:center}
      .hero h1{font-size:clamp(32px,5vw,54px);line-height:1.05;margin:0 0 14px;color:#075c34}
      .hero img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:14px}
      .cta{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.btn{display:inline-block;padding:12px 16px;border-radius:10px;background:#087443;color:#fff;text-decoration:none;font-weight:800}
      .btn.alt{background:#eef8f2;color:#075c34;border:1px solid #b8d7c5}
      .note{background:#eef8f2;border-left:5px solid #087443;padding:14px;border-radius:8px}
      .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}.card{border:1px solid #d7e5dc;border-radius:12px;padding:16px;background:#fbfdfc}
      h2{color:#075c34;margin-top:0}h3{color:#17352a}.link-list{display:flex;flex-wrap:wrap;gap:10px;padding:0;list-style:none}.link-list a{display:block;padding:10px 12px;border-radius:9px;background:#eef8f2;text-decoration:none;font-weight:700}
      footer{background:#17352a;color:#fff;text-align:center;padding:28px 20px}footer a{color:#fff}
      @media(max-width:760px){header{position:static}.bar{display:block}.bar nav{margin-top:10px}.hero{grid-template-columns:1fr}section{padding:20px}.hero img{order:-1}}
    </style>
  </head>
  <body>
    <header>
      <div class="bar">
        <a class="brand" href="/">Free Reliable <span>Appliance Pickup</span></a>
        <nav aria-label="Main navigation">
          <a href={`${liveSite}/how-appliance-pickup-works/`}>How It Works</a>
          <a href={`${liveSite}/service-areas/`}>Service Areas</a>
          <a href={`${liveSite}/free-pickup-qualification/`}>Qualifications</a>
          <a href="#request">Request Pickup</a>
        </nav>
      </div>
    </header>

    <main>
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">V2 Home</a> ›
        <a href={`${liveSite}/california-appliance-pickup/`}>{page.state}</a> ›
        <a href={marketHubUrl}>{page.market}</a> ›
        <span>{page.city}</span>
      </nav>

      <section class="hero">
        <div>
          <p><strong>{page.market}</strong> · {page.county}</p>
          <h1>Free Appliance Pickup & Removal in {page.city}, {page.stateCode}</h1>
          <p>{page.serviceSummary}</p>
          <p><strong>{page.hours}</strong> · English / Español</p>
          <div class="cta">
            <a class="btn" href={`tel:${page.phoneE164}`}>Call {page.phoneDisplay}</a>
            <a class="btn alt" href={`sms:${page.phoneE164}`}>Text Appliance Photos</a>
            <a class="btn alt" href="#request">Request Pickup</a>
          </div>
          <p class="note"><strong>Free to submit · No account required.</strong> Pickup is confirmed only after qualification and route review.</p>
        </div>
        <img src={heroImageUrl} alt={page.heroImageAlt} width="768" height="576" loading="eager" fetchpriority="high" />
      </section>

      <section>
        <h2>Free-Pickup Qualification</h2>
        <p>{page.qualificationSummary}</p>
      </section>

      <section>
        <h2>{page.city} Local Route Context</h2>
        <p>{page.localContext}</p>
      </section>

      <section>
        <h2>Appliance Pickup Options in {page.city}</h2>
        <ul class="link-list">
          {page.applianceLinks.map((item) => (
            <li><a href={absoluteHref(item.href)}>{item.label}</a></li>
          ))}
        </ul>
      </section>

      <section>
        <h2>{page.city} Neighborhoods & ZIP Codes</h2>
        <div class="grid">
          <div class="card"><h3>Neighborhood examples</h3><p>{page.neighborhoods.join(", ")}.</p></div>
          <div class="card"><h3>Common ZIP codes</h3><p>{page.zipCodes.join(", ")}.</p></div>
        </div>
        <p>Use the actual pickup address rather than a nearby city name. Exact access, appliance condition and route direction are reviewed before pickup is confirmed.</p>
      </section>

      <section>
        <h2>Nearby Appliance Pickup Areas</h2>
        <ul class="link-list">
          {page.nearbyLinks.map((item) => (
            <li><a href={item.href}>{item.label} appliance pickup</a></li>
          ))}
        </ul>
      </section>

      <section>
        <h2>{page.city} Appliance Pickup FAQ</h2>
        {page.faqs.map((faq) => (
          <article>
            <h3>{faq.question}</h3>
            <p>{faq.answer}</p>
          </article>
        ))}
      </section>

      <PickupRequestForm city={page.city} state={page.stateCode} sourcePage={page.canonical} />
    </main>

    <footer>
      Free Reliable Appliance Pickup · {page.city}, California ·
      <a href={`tel:${page.phoneE164}`}>{page.phoneDisplay}</a>
    </footer>
  </body>
</html>
