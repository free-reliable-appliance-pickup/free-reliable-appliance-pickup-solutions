---
import { getSecret } from "astro:env/server";
import { createClient } from "@supabase/supabase-js";
import { ADMIN_COOKIE, expectedAdminSession } from "../../lib/adminAuth";
import { locationPages } from "../../data/locations";

export const prerender = false;

const expected = await expectedAdminSession();
const current = Astro.cookies.get(ADMIN_COOKIE)?.value || "";

if (!expected || current !== expected) {
  return Astro.redirect("/admin/login/");
}

const supabaseUrl = getSecret("SUPABASE_URL");
const serviceRoleKey = getSecret("SUPABASE_SERVICE_ROLE_KEY");

if (!supabaseUrl || !serviceRoleKey) {
  throw new Error("Supabase server environment is not configured.");
}

const supabase = createClient(supabaseUrl, serviceRoleKey, {
  auth: { persistSession: false, autoRefreshToken: false }
});

const [
  { data: funnelRows, error: funnelError },
  { data: recentLeads, error: leadsError },
  { count: leadCount, error: leadCountError },
  { data: siteMetrics, error: siteMetricError },
  { data: partnerApplications, error: partnerApplicationsError },
  { count: activeTerritoryCount, error: activeTerritoryError }
] = await Promise.all([
  supabase
    .from("reporting_page_funnel")
    .select("*")
    .order("organic_impressions", { ascending: false })
    .limit(50),
  supabase
    .from("appliance_leads")
    .select("id,created_at,customer_name,city,state,zip_code,appliance_type,appliance_condition,status,market_priority,source_channel,source_page,tracking_data", { count: "exact" })
    .order("created_at", { ascending: false })
    .limit(25),
  supabase
    .from("appliance_leads")
    .select("*", { count: "exact", head: true }),
  supabase
    .from("seo_period_metrics")
    .select("period_start,period_end,clicks,impressions,ctr,avg_position")
    .eq("search_engine", "google")
    .eq("metric_scope", "site")
    .order("period_end", { ascending: false })
    .limit(1),
  supabase
    .from("partner_applications")
    .select("id,status,city,state,selected_cities,number_of_cities")
    .order("created_at", { ascending: false }),
  supabase
    .from("partner_territories")
    .select("*", { count: "exact", head: true })
    .eq("status", "active")
]);

if (funnelError) console.error("Dashboard funnel query failed", funnelError);
if (leadsError) console.error("Dashboard leads query failed", leadsError);
if (leadCountError) console.error("Dashboard lead count failed", leadCountError);
if (siteMetricError) console.error("Dashboard site metric query failed", siteMetricError);
if (partnerApplicationsError) console.error("Dashboard partner application query failed", partnerApplicationsError);
if (activeTerritoryError) console.error("Dashboard active territory count failed", activeTerritoryError);

const rows = funnelRows || [];
const leads = recentLeads || [];
const siteMetric = siteMetrics?.[0] || null;
const partnerApps = partnerApplications || [];

const priorityCities = new Set(
  locationPages
    .filter((page) => page.slug.endsWith("-appliance-pickup"))
    .map((page) => page.city)
);

const partnerCoverage = new Map<string, { applications: number; statuses: Set<string> }>();
for (const application of partnerApps) {
  const selected = Array.isArray(application.selected_cities) ? application.selected_cities : [];
  for (const selectedCity of selected) {
    const cityName = String(selectedCity || "").replace(/,\s*CA$/i, "").trim();
    if (!priorityCities.has(cityName)) continue;
    const current = partnerCoverage.get(cityName) || { applications: 0, statuses: new Set<string>() };
    current.applications += 1;
    current.statuses.add(String(application.status || "unknown"));
    partnerCoverage.set(cityName, current);
  }
}

const partnerCoverageRows = Array.from(priorityCities)
  .map((city) => {
    const coverage = partnerCoverage.get(city);
    return {
      city,
      applications: coverage?.applications || 0,
      statuses: coverage ? Array.from(coverage.statuses).join(", ") : "none"
    };
  })
  .sort((a, b) => b.applications - a.applications || a.city.localeCompare(b.city));

const pendingPartnerCount = partnerApps.filter((application) => application.status === "pending").length;

let keywordRows: any[] = [];
if (siteMetric) {
  const { data, error } = await supabase
    .from("seo_period_metrics")
    .select("query,clicks,impressions,ctr,avg_position")
    .eq("search_engine", "google")
    .eq("metric_scope", "query")
    .eq("period_start", siteMetric.period_start)
    .eq("period_end", siteMetric.period_end)
    .order("impressions", { ascending: false })
    .limit(40);

  if (error) console.error("Dashboard keyword query failed", error);
  keywordRows = data || [];
}

const periodStart = siteMetric?.period_start || rows[0]?.period_start || "—";
const periodEnd = siteMetric?.period_end || rows[0]?.period_end || "—";

const googleImpressions = Number(siteMetric?.impressions || 0);
const googleClicks = Number(siteMetric?.clicks || 0);
const googleCtr = Number(siteMetric?.ctr || 0);
const googlePosition = siteMetric?.avg_position;

const periodLeads = rows.reduce((sum, row) => sum + Number(row.leads || 0), 0);

function pct(value: unknown) {
  const n = Number(value);
  if (!Number.isFinite(n)) return "—";
  return `${(n * 100).toFixed(1)}%`;
}

function pos(value: unknown) {
  const n = Number(value);
  return Number.isFinite(n) ? n.toFixed(1) : "—";
}

function shortPage(value: unknown) {
  const text = String(value || "");
  try {
    return new URL(text).pathname;
  } catch {
    return text || "—";
  }
}

function positionBand(value: unknown) {
  const n = Number(value);
  if (!Number.isFinite(n)) return "—";
  if (n <= 3) return "Top 3";
  if (n <= 10) return "Positions 4–10";
  if (n <= 20) return "Positions 11–20";
  return "Position 21+";
}

function trackingValue(lead: any, key: string) {
  const tracking = lead?.tracking_data;
  if (!tracking || typeof tracking !== "object") return "";
  const value = tracking[key];
  return typeof value === "string" ? value : "";
}

function intentLabel(lead: any) {
  return trackingValue(lead, "service_intent") === "washer-dryer"
    ? "Washer / Dryer"
    : "General Appliance";
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Owner Dashboard | Free Reliable Appliance Pickup</title>
    <style>
      *{box-sizing:border-box}
      body{margin:0;background:#f4f7f5;color:#17352a;font-family:Arial,sans-serif}
      header{background:#17352a;color:white;padding:18px}
      header .inner{max-width:1200px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:16px}
      header h1{font-size:22px;margin:0}
      button{border:0;border-radius:8px;padding:9px 13px;font-weight:700;cursor:pointer}
      main{max-width:1200px;margin:auto;padding:22px}
      .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin:18px 0}
      .card{background:white;border:1px solid #d7e5dc;border-radius:12px;padding:18px}
      .card strong{display:block;font-size:28px;margin-top:6px}
      section{background:white;border:1px solid #d7e5dc;border-radius:12px;padding:18px;margin:18px 0;overflow:auto}
      table{width:100%;border-collapse:collapse;min-width:850px}
      th,td{text-align:left;padding:10px;border-bottom:1px solid #e6ece8;vertical-align:top}
      th{background:#eef6f1;position:sticky;top:0}
      .muted{color:#5e6f65;font-size:14px}
      .good{font-weight:700}
      .empty{padding:18px;background:#fafcfa;border-radius:8px}
      .band{white-space:nowrap;font-size:13px;font-weight:700}
    </style>
  </head>
  <body>
    <header>
      <div class="inner">
        <div>
          <h1>Free Reliable Appliance Pickup — Owner Dashboard</h1>
          <div>Rankings → Traffic → Leads</div>
        </div>
        <form method="post" action="/api/admin/logout">
          <button type="submit">Log out</button>
        </form>
      </div>
    </header>

    <main>
      <p class="muted">
        Google reporting period: {periodStart} through {periodEnd}. Search Console data is finalized with a delay.
      </p>

      <div class="cards">
        <div class="card">Google impressions<strong>{googleImpressions.toLocaleString()}</strong></div>
        <div class="card">Google clicks<strong>{googleClicks.toLocaleString()}</strong></div>
        <div class="card">Google CTR<strong>{pct(googleCtr)}</strong></div>
        <div class="card">Average position<strong>{pos(googlePosition)}</strong></div>
        <div class="card">Tracked leads in period<strong>{periodLeads.toLocaleString()}</strong></div>
        <div class="card">All stored leads<strong>{Number(leadCount || 0).toLocaleString()}</strong></div>
        <div class="card">Pending partner applications<strong>{pendingPartnerCount.toLocaleString()}</strong></div>
        <div class="card">Active partner territories<strong>{Number(activeTerritoryCount || 0).toLocaleString()}</strong></div>
      </div>

      <section>
        <h2>Search queries</h2>
        <p class="muted">These are finalized Google Search Console query measurements for the same reporting period.</p>
        {keywordRows.length === 0 ? (
          <div class="empty">No query snapshot is available yet.</div>
        ) : (
          <table>
            <thead>
              <tr>
                <th>Query</th>
                <th>Impressions</th>
                <th>Clicks</th>
                <th>CTR</th>
                <th>Avg position</th>
                <th>Position band</th>
              </tr>
            </thead>
            <tbody>
              {keywordRows.map((row) => (
                <tr>
                  <td><span class="good">{row.query}</span></td>
                  <td>{Number(row.impressions || 0).toLocaleString()}</td>
                  <td>{Number(row.clicks || 0).toLocaleString()}</td>
                  <td>{pct(row.ctr)}</td>
                  <td>{pos(row.avg_position)}</td>
                  <td class="band">{positionBand(row.avg_position)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </section>

      <section>
        <h2>SEO page performance vs leads</h2>
        {rows.length === 0 ? (
          <div class="empty">No SEO reporting snapshot has been imported yet.</div>
        ) : (
          <table>
            <thead>
              <tr>
                <th>Page</th>
                <th>Impressions</th>
                <th>Clicks</th>
                <th>CTR</th>
                <th>Avg position</th>
                <th>Leads</th>
                <th>Progressed</th>
                <th>Lead / click</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr>
                  <td><span class="good">{shortPage(row.page_url)}</span></td>
                  <td>{Number(row.organic_impressions || 0).toLocaleString()}</td>
                  <td>{Number(row.organic_clicks || 0).toLocaleString()}</td>
                  <td>{pct(row.organic_ctr)}</td>
                  <td>{pos(row.avg_position)}</td>
                  <td>{Number(row.leads || 0)}</td>
                  <td>{Number(row.progressed_leads || 0)}</td>
                  <td>{row.lead_per_click == null ? "—" : pct(row.lead_per_click)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </section>

      <section>
        <h2>Priority corridor partner coverage</h2>
        <p class="muted">Application interest is not the same as active service. This table shows which V2 corridor cities appear in submitted partner applications and whether an active territory has been created separately.</p>
        <table>
          <thead>
            <tr>
              <th>City</th>
              <th>Partner applications selecting city</th>
              <th>Application status</th>
            </tr>
          </thead>
          <tbody>
            {partnerCoverageRows.map((row) => (
              <tr>
                <td><span class="good">{row.city}</span></td>
                <td>{row.applications}</td>
                <td>{row.statuses}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <section>
        <h2>Latest pickup requests</h2>
        {leads.length === 0 ? (
          <div class="empty">No tracked pickup requests are stored yet.</div>
        ) : (
          <table>
            <thead>
              <tr>
                <th>Received</th>
                <th>Customer</th>
                <th>Location</th>
                <th>Priority</th>
                <th>Lead type</th>
                <th>Appliance</th>
                <th>Condition</th>
                <th>Market</th>
                <th>Source</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {leads.map((lead) => (
                <tr>
                  <td>{new Date(lead.created_at).toLocaleString("en-US")}</td>
                  <td>{lead.customer_name || "—"}</td>
                  <td>{[lead.city, lead.state, lead.zip_code].filter(Boolean).join(", ")}</td>
                  <td><span class="good">{lead.market_priority || "—"}</span></td>
                  <td><span class="good">{intentLabel(lead)}</span></td>
                  <td>{lead.appliance_type || "—"}</td>
                  <td>{lead.appliance_condition || "—"}</td>
                  <td>{trackingValue(lead, "market") || "—"}</td>
                  <td>
                    <div>{lead.source_channel || "—"}</div>
                    <div class="muted">{shortPage(lead.source_page)}</div>
                  </td>
                  <td>{lead.status || "—"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </section>
    </main>
  </body>
</html>
