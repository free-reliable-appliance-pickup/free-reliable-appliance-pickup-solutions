---
import { locationPages } from "../data/locations";

const title = "Free Reliable Appliance Pickup — IE + SGV V2";
const description = "Staging index for the Inland Empire and San Gabriel Valley appliance pickup corridor.";
const appliancePages = locationPages.filter((page) => page.slug.endsWith("-appliance-pickup"));
const marketOrder = ["Inland Empire", "SGV–Inland Empire Corridor", "San Gabriel Valley"];
const markets = marketOrder.map((market) => ({
  market,
  pages: appliancePages.filter((page) => page.market === market)
}));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://freereliableappliancepickup.com/" />
    <style>
      :root{font-family:Arial,Helvetica,sans-serif;color:#17352a;background:#f5f7f6}
      *{box-sizing:border-box}body{margin:0;line-height:1.55;background:#f5f7f6}
      main{max-width:1180px;margin:auto;padding:34px 20px 60px}
      h1{font-size:clamp(34px,5vw,58px);line-height:1.05;color:#075c34;margin:0 0 12px}
      h2{color:#075c34;margin:36px 0 14px}.lead{max-width:820px;font-size:18px}
      .summary{display:flex;gap:12px;flex-wrap:wrap;margin:24px 0}.pill{background:#fff;border:1px solid #d7e5dc;border-radius:999px;padding:9px 13px;font-weight:700}
      .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:14px}
      .card{background:#fff;border:1px solid #d7e5dc;border-radius:14px;padding:18px}
      .card h3{margin:0 0 10px}.links{display:flex;gap:8px;flex-wrap:wrap}
      a{color:#07683d}.btn{display:inline-block;background:#087443;color:#fff;text-decoration:none;padding:9px 11px;border-radius:9px;font-weight:800}
      .btn.alt{background:#eef8f2;color:#075c34;border:1px solid #b8d7c5}
      .note{margin-top:34px;background:#eef8f2;border-left:5px solid #087443;padding:16px;border-radius:10px}
    </style>
  </head>
  <body>
    <main>
      <p><strong>Platform V2 staging</strong></p>
      <h1>Inland Empire + San Gabriel Valley First</h1>
      <p class="lead">This first V2 operating corridor is built around the markets with the strongest current pickup-partner demand for washers, dryers and reusable major appliances. The staging site remains isolated and noindex while pages, forms and routing are tested.</p>
      <div class="summary">
        <span class="pill">{appliancePages.length} locations</span>
        <span class="pill">{locationPages.length} local service pages</span>
        <span class="pill">General appliance + washer/dryer intent</span>
      </div>

      {markets.map(({ market, pages }) => (
        <section>
          <h2>{market}</h2>
          <div class="grid">
            {pages.map((page) => {
              const base = page.slug.replace(/-appliance-pickup$/, "");
              return (
                <article class="card">
                  <h3>{page.city}</h3>
                  <p>{page.county}</p>
                  <div class="links">
                    <a class="btn" href={`/${page.slug}/`}>Appliance Pickup</a>
                    <a class="btn alt" href={`/${base}-washer-dryer-pickup/`}>Washer & Dryer</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      ))}

      <p class="note"><strong>Safety rule:</strong> no public-domain cutover is part of this staging expansion. Each priority URL still needs SEO-parity, form, mobile, analytics and routing checks before any migration.</p>
    </main>
  </body>
</html>
