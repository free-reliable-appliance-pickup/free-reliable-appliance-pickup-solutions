---
import { locationPages } from "../data/locations";

const title = "Platform V2 | Free Reliable Appliance Pickup";
const description = "Private noindex staging preview for the Free Reliable Appliance Pickup V2 local-service platform.";
const groups = Array.from(new Set(locationPages.map((page) => page.market))).map((market) => ({
  market,
  pages: locationPages.filter((page) => page.market === market)
}));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://freereliableappliancepickup.com/" />
    <style>
      :root{font-family:Arial,Helvetica,sans-serif;color:#17352a;background:#f5f7f6}
      *{box-sizing:border-box}body{margin:0;background:#f5f7f6;line-height:1.6}
      main{max-width:1100px;margin:auto;padding:40px 20px}.hero,.group{background:#fff;border:1px solid #d7e5dc;border-radius:16px;padding:26px;margin-bottom:18px}
      h1,h2{color:#075c34}h1{font-size:clamp(34px,5vw,54px);line-height:1.05}
      .pill{display:inline-block;padding:6px 10px;border-radius:999px;background:#eef8f2;font-weight:700}
      .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
      a.card{display:block;padding:16px;border:1px solid #d7e5dc;border-radius:12px;background:#fbfdfc;color:#075c34;text-decoration:none;font-weight:800}
      a.card small{display:block;color:#5a6a62;font-weight:400;margin-top:4px}
    </style>
  </head>
  <body>
    <main>
      <section class="hero">
        <span class="pill">Private staging · noindex</span>
        <h1>Free Reliable Appliance Pickup — Platform V2</h1>
        <p>This preview is separate from the live website. The first rollout covers the Rancho Cucamonga / Inland Empire / San Bernardino corridor and the connected San Gabriel Valley corridor.</p>
        <p><strong>{locationPages.length} local V2 pages are currently generated.</strong></p>
      </section>

      {groups.map((group) => (
        <section class="group">
          <h2>{group.market}</h2>
          <div class="grid">
            {group.pages.map((page) => (
              <a class="card" href={`/${page.slug}/`}>
                {page.city}
                <small>{page.county} · {page.phoneDisplay}</small>
              </a>
            ))}
          </div>
        </section>
      ))}
    </main>
  </body>
</html>
