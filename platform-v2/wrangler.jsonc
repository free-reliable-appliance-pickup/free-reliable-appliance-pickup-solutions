{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "free-reliable-appliance-pickup-v2-staging",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
